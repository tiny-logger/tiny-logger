{
    "name": "serhii/tiny-logger",
    "description": "Light weight composer package for file logging in PHP7.",
    "homepage": "https://codeberg.org/tiny-logger/tiny-logger",
    "keywords": ["logger", "library"],
    "type": "library",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "ext-curl": "*",
        "curl/curl": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.64",
        "symfony/var-dumper": "6.2.13",
        "phpstan/phpstan": "2.2.8",
        "squizlabs/php_codesniffer": "4.0.4",
        "arokettu/private-access": "3.1.0",
        "laravel/pint": "1.20.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "SerhiiCho",
            "email": "serhiicho@protonmail.com",
            "homepage": "https://serhiicho.com/about-me",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Serhii\\TinyLogger\\": "src"
        },
        "files": [
            "logger.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Serhii\\Tests\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "stan": "phpstan analyse",
        "cs": "phpcs src logger.php --colors -p",
        "test": "phpunit --colors",
        "pint": "pint --test",
        "check": [
            "@stan",
            "@cs",
            "@test",
            "@pint"
        ]
    }
}
